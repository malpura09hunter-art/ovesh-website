<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login | OveshMalpura Cyber Labs</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #030a03; --bg2: #060f06; --bg3: #0a160a;
  --neon: #00ff41; --neon2: #00cc33; --neon3: #39ff14; --dim: #00aa22;
  --text: #c8ffd4; --muted: #4a7a52;
  --card: rgba(0,255,65,0.04); --border: rgba(0,255,65,0.15);
  --glow: 0 0 20px rgba(0,255,65,0.4), 0 0 60px rgba(0,255,65,0.1);
  --error: #ff4455;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg); color: var(--text); font-family: 'Rajdhani', sans-serif;
  min-height: 100vh; display: flex; align-items: center; justify-content: center;
  padding: 24px; position: relative; overflow: hidden;
}
body::before {
  content: ''; position: fixed; inset: 0;
  background-image: radial-gradient(rgba(0,255,65,0.06) 1px, transparent 1px);
  background-size: 24px 24px; pointer-events: none;
}
.logo-link { position: absolute; top: 28px; left: 28px; font-family: 'Orbitron', sans-serif; font-weight: 900; color: var(--neon3); text-decoration: none; letter-spacing: 2px; font-size: 15px; text-shadow: 0 0 10px rgba(0,255,65,0.4); }
.card {
  width: 100%; max-width: 420px; background: var(--bg2); border: 1px solid var(--border);
  border-radius: 12px; padding: 40px 32px; box-shadow: var(--glow); position: relative; z-index: 1;
}
.eyebrow { font-family: 'Share Tech Mono', monospace; font-size: 12px; color: var(--dim); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; }
h1 { font-family: 'Orbitron', sans-serif; font-size: 24px; font-weight: 700; color: var(--neon3); margin-bottom: 8px; }
.sub { font-size: 13px; color: var(--muted); margin-bottom: 24px; font-family: 'Share Tech Mono', monospace; }
.field { margin-bottom: 18px; }
.field label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 6px; font-family: 'Share Tech Mono', monospace; letter-spacing: 1px; }
.field input {
  width: 100%; background: rgba(0,255,65,0.03); border: 1px solid var(--border); border-radius: 6px;
  padding: 12px 14px; color: var(--text); font-family: 'Rajdhani', sans-serif; font-size: 16px; outline: none; transition: border-color 0.2s;
}
.field input:focus { border-color: var(--neon2); box-shadow: 0 0 0 3px rgba(0,255,65,0.08); }
.btn-primary {
  width: 100%; background: var(--neon2); color: #021002; border: none; border-radius: 6px;
  padding: 13px; font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1px;
  cursor: pointer; transition: all 0.2s; text-transform: uppercase;
}
.btn-primary:hover { background: var(--neon3); box-shadow: var(--glow); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.msg { padding: 10px 12px; border-radius: 6px; font-size: 14px; margin-bottom: 16px; display: none; }
.msg.error { background: rgba(255,68,85,0.1); border: 1px solid rgba(255,68,85,0.3); color: var(--error); display: block; }
.msg.success { background: rgba(0,255,65,0.08); border: 1px solid var(--border); color: var(--neon3); display: block; }
.divider-row { display: flex; align-items: center; gap: 12px; margin: 18px 0; }
.divider-row::before, .divider-row::after { content: ''; flex: 1; height: 1px; background: var(--border); }
.divider-row span { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--muted); letter-spacing: 2px; }
.btn-google {
  width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px;
  background: #ffffff; color: #3c4043; border: 1px solid #dadce0; border-radius: 6px;
  padding: 12px; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 15px;
  cursor: pointer; transition: box-shadow 0.2s, background 0.2s; position: relative;
}
.btn-google:hover { box-shadow: 0 1px 6px rgba(0,0,0,0.35); background: #f8f8f8; }
.btn-google:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-google .g-icon { width: 18px; height: 18px; flex-shrink: 0; }
.btn-google .spinner {
  width: 16px; height: 16px; border: 2px solid #dadce0; border-top-color: #3c4043;
  border-radius: 50%; animation: spin 0.7s linear infinite; display: none;
}
.btn-google.loading .g-icon { display: none; }
.btn-google.loading .btn-google-label { display: none; }
.btn-google.loading .spinner { display: block; }
@keyframes spin { to { transform: rotate(360deg); } }
.lock-badge { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 12px; color: var(--muted); font-family: 'Share Tech Mono', monospace; justify-content: center; }
</style>
</head>
<body>

<a href="../index.html" class="logo-link">← OVESH MALPURA CYBER LABS</a>

<div class="card">
  <div class="eyebrow">Restricted Access</div>
  <h1>Admin Command Center</h1>
  <div class="sub">Authorized personnel only. All sign-ins are logged.</div>

  <div class="msg" id="formMsg"></div>

  <form id="loginForm">
    <div class="field"><label>Admin Email</label><input type="email" id="loginEmail" required autocomplete="email"></div>
    <div class="field"><label>Password</label><input type="password" id="loginPassword" required autocomplete="current-password"></div>
    <button class="btn-primary" type="submit" id="loginBtn">Access Console</button>
  </form>

  <div class="divider-row"><span>OR</span></div>
  <button type="button" class="btn-google" id="googleBtnLogin" onclick="handleGoogleSignIn(this)">
    <svg class="g-icon" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.5-5.2l-6.2-5.3C29.3 35.4 26.8 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.6 39.6 16.3 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.2 5.3C40.9 36 44 30.6 44 24c0-1.3-.1-2.7-.4-3.5z"/></svg>
    <span class="spinner"></span>
    <span class="btn-google-label">Continue with Google</span>
  </button>

  <div class="lock-badge">🔒 Protected by Firebase Auth + admin allowlist</div>
</div>

<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<script src="../firebase-config.js"></script>
<script>
const formMsg = document.getElementById('formMsg');

function showMsg(type, text) {
  formMsg.className = 'msg ' + type;
  formMsg.textContent = text;
}

// If already signed in AND already an admin, skip straight to the dashboard.
// If signed in but NOT an admin, stay on this page silently (don't bounce
// a logged-in client user around) so they can try a different account.
auth.onAuthStateChanged(async (user) => {
  if (!user) return;
  try {
    const adminDoc = await db.collection('admins').doc(user.uid).get();
    if (adminDoc.exists) window.location.href = 'dashboard.html';
  } catch (e) { /* stay on login */ }
});

async function verifyAdminThenRedirect(user) {
  const adminDoc = await db.collection('admins').doc(user.uid).get();
  if (!adminDoc.exists) {
    await auth.signOut();
    showMsg('error', 'This account does not have admin access.');
    return;
  }
  showMsg('success', 'Access granted. Loading console…');
  window.location.href = 'dashboard.html';
}

document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('loginBtn');
  btn.disabled = true;
  formMsg.className = 'msg';
  try {
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;
    const cred = await auth.signInWithEmailAndPassword(email, password);
    await verifyAdminThenRedirect(cred.user);
  } catch (err) {
    showMsg('error', friendlyError(err));
  } finally {
    btn.disabled = false;
  }
});

async function handleGoogleSignIn(btn) {
  btn.classList.add('loading');
  btn.disabled = true;
  formMsg.className = 'msg';
  try {
    const result = await auth.signInWithPopup(googleProvider);
    await syncGoogleUserDoc(result.user);
    await verifyAdminThenRedirect(result.user);
  } catch (err) {
    showMsg('error', friendlyError(err));
  } finally {
    btn.classList.remove('loading');
    btn.disabled = false;
  }
}
</script>
</body>
</html>
